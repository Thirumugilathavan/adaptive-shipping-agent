# Adaptive Shipping Intelligence Agent - Environment Configuration
# Copy this file to .env and configure values. Do not commit .env with secrets.

# Operating Mode: "demo" (default) or "shipsandbox"
SHIPPING_PROVIDER_MODE=demo

# Verified ShipSandbox API Credentials (Required only when mode is "shipsandbox")
SHIPSANDBOX_BASE_URL=https://api.shipsandbox.example.com
SHIPSANDBOX_API_KEY=your_sandbox_api_key_here
SHIPSANDBOX_WEBHOOK_SECRET=your_webhook_hmac_secret_here

# Calculation Defaults (Demonstration defaults, configurable per courier)
DEFAULT_VOLUMETRIC_DIVISOR=5000.0
DEFAULT_MIN_BILLABLE_WEIGHT_KG=0.5
DEFAULT_BILLING_STEP_KG=0.5
DEFAULT_GST_RATE_PCT=18.0

# Database & Storage
SQLITE_DB_PATH=shipping_agent.db
